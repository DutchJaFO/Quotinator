<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>Developer-only tool — runs an arbitrary SQL query against a Quotinator SQLite database file and prints the result set. Not part of the shipped product.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.79" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.10" />
    <!-- CVE-2025-6965: native-binary-only override; Microsoft.Data.Sqlite still floors SQLitePCLRaw.core at 2.1.11, but this package carries no managed deps so it upgrades independently. See CVE/CVE-2025-6965.md. -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Quotinator.Tools.DbInspector.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>

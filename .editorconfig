root = true

[*.cs]

# #244 Step 2: escalated one rule family at a time, each landing at 0 warnings before the next is
# added — see docs/milestones/maintenance-milestone-v1.8.0/244-hidden-analyzer-diagnostics-plan.md.
# These four are the collection-expression-simplification family (all four flag exactly the same
# transformation — `new[] { ... }`/`new List<T> { ... }`/`.ToList()`/`.ToArray()`/`.ToHashSet()` at
# the end of a chain, or `new()` on a field initializer — becoming `[...]`/`[.. ...]` syntax): purely
# syntactic, verified by hand against the full diff before landing, no behaviour change possible for
# any of the 202 occurrences fixed in the same commit as this entry.
dotnet_diagnostic.IDE0305.severity = warning
dotnet_diagnostic.IDE0300.severity = warning
dotnet_diagnostic.IDE0301.severity = warning
dotnet_diagnostic.IDE0028.severity = warning

# Step 2b: member-name simplification, deconstruction, null-check simplification, unnecessary
# assignment, local function vs lambda, simple using statement, readonly field. Found live: the
# IDE0270 (null-check simplification) fix on SqliteImportActionService.cs correctly narrowed a
# `Guid?` local to `Guid` via `?? throw`, but two downstream `.Value` accesses weren't updated by
# the tool and had to be fixed by hand — dotnet format applies a diagnostic-correct fix without
# checking whether it invalidates code elsewhere in the same file.
dotnet_diagnostic.IDE0037.severity = warning
dotnet_diagnostic.IDE0042.severity = warning
dotnet_diagnostic.IDE0270.severity = warning
dotnet_diagnostic.IDE0059.severity = warning
dotnet_diagnostic.IDE0039.severity = warning
dotnet_diagnostic.IDE0063.severity = warning
dotnet_diagnostic.IDE0044.severity = warning

# Step 3: primary constructors. `dotnet format` only performs the mechanical syntax conversion — it
# does not write per-parameter XML docs, so every constructor parameter across all ~33 converted
# classes was documented by hand (no exceptions) before this severity was escalated. CS1591 only
# checks that *a* doc comment exists on a public member, not that every parameter has its own
# <param> tag, so a clean build alone could not have caught missing parameter documentation here.
dotnet_diagnostic.IDE0290.severity = warning

# Step 4: namespace/folder mismatch. All 4 hits were Quotinator.Core.Tests files declared under
# `namespace Quotinator.Core.Tests.Data` while living in Database/ or Services/ — a real violation of
# CLAUDE.md's file placement rule, not a style nit. Confirmed no cross-file references to the affected
# classes before renaming each file's namespace to match its actual folder.
dotnet_diagnostic.IDE0130.severity = warning

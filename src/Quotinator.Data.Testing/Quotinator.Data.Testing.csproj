<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Description>Test helpers for Quotinator.Data — no-op stubs, configurable fakes, and a disposable temp SQLite database. Reference from test projects only.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.79" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.10" />
    <!-- CVE-2025-6965: native-binary-only override; Microsoft.Data.Sqlite still floors SQLitePCLRaw.core at 2.1.11, but this package carries no managed deps so it upgrades independently. See CVE/CVE-2025-6965.md. -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.50.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Quotinator.Data\Quotinator.Data.csproj" />
  </ItemGroup>

</Project>

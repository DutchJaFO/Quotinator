<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">
            <img src="favicon.png" alt="" aria-hidden="true" class="navbar-brand-logo" />Quotinator
        </a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            @if (DatabaseHealth.IsHealthy)
            {
                <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                    <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> @Text.HomeNavLabel
                </NavLink>
            }
            else
            {
                <span class="nav-link disabled" aria-disabled="true">
                    <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> @Text.HomeNavLabel
                </span>
            }
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="rest-api">
                <span class="bi bi-code-slash-nav-menu" aria-hidden="true"></span> @Text.RestApiNavLabel
                @if (!DatabaseHealth.IsHealthy)
                {
                    <span class="badge bg-warning text-dark ms-1">@Text.RestApiLimitedBadge</span>
                }
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="stats">
                <span class="bi bi-graph-up-nav-menu" aria-hidden="true"></span> @Text.StatsNavLabel
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="notifications">
                <span class="bi bi-bell-fill-nav-menu" aria-hidden="true"></span> @Text.NotificationsNavLabel
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="import-review">
                <span class="bi bi-list-check-nav-menu" aria-hidden="true"></span> @Text.ImportReviewNavLabel
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="about">
                <span class="bi bi-info-circle-fill-nav-menu" aria-hidden="true"></span> @Text.AboutNavLabel
            </NavLink>
        </div>
    </nav>

    <div class="settings-section">
        <span class="settings-section__heading">@Text.SettingsNavLabel</span>
        <LanguageSelector />
    </div>
</div>

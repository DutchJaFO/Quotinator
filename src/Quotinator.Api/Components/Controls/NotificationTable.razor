@using Quotinator.Data.Enums

<table class="table table-sm">
    <thead>
        <tr>
            <th>@Text.NotificationsCreatedColumn</th>
            <th>@Text.NotificationsTypeColumn</th>
            <th>@Text.NotificationsMessageColumn</th>
            <th>@Text.NotificationsExpiresColumn</th>
            <th>@Text.NotificationsStatusColumn</th>
            @if (ShowActionColumn)
            {
                <th>@Text.NotificationsActionColumn</th>
            }
            @if (ShowDismissAction)
            {
                <th></th>
            }
        </tr>
    </thead>
    <tbody>
        @foreach (var notification in Notifications)
        {
            <tr>
                <td>@Local(notification.DateCreated.Parsed)</td>
                <td><span class="badge @BadgeClass(notification.Type.Parsed)">@TypeLabel(notification.Type.Parsed)</span></td>
                <td>
                    @if (ShowsTitle(notification))
                    {
                        <div class="notification-title">@notification.Title</div>
                    }
                    <div class="notification-body">@notification.Body</div>
                    @{
                        var detail = PayloadLines(notification, Text);
                        var resolution = notification.Resolution.Parsed;
                    }
                    @if (resolution is not null)
                    {
                        @* #308: what the action actually did. The body is frozen at write time and
                           still asks for the decision that has since been made. *@
                        <div class="notification-resolution">@ResolutionLabel(resolution.Value)</div>
                    }
                    @if (detail.Count > 0)
                    {
                        @* Collapsed by default on the page: the summary above is what a scan needs, and
                           the detail is what a reader who stopped on this row wants. A native disclosure
                           element rather than a JS component — no circuit and no state of our own.
                           Do not name the element inside this comment: a literal tag in a Razor comment
                           is parsed as markup, which broke real startup here (#308, 2026-09-02). *@
                        <details class="notification-detail">
                            <summary>@Text.NotificationsDetailToggle</summary>
                            <ul>
                                @foreach (string line in detail)
                                {
                                    <li>@line</li>
                                }
                            </ul>
                        </details>
                    }
                </td>
                <td>@Local(notification.ExpiresAt.Parsed)</td>
                <td>
                    @switch (GetDisplayStatus(notification, Now, Executing.IsExecuting(notification.Id)))
                    {
                        case NotificationDisplayStatus.Executing:
                            @* aria-hidden: the badge's own text already says it is running, so the
                               spinner is decoration and must not be announced a second time. *@
                            <span class="badge bg-info">
                                <span class="spinner-border" aria-hidden="true"></span>
                                @Text.NotificationsExecutingLabel
                            </span>
                            break;
                        case NotificationDisplayStatus.Resolved:
                            <span class="badge bg-primary">@Text.NotificationsResolvedLabel</span>
                            break;
                        case NotificationDisplayStatus.Dismissed:
                            <span class="badge bg-secondary">@Text.NotificationsDismissedLabel</span>
                            break;
                        case NotificationDisplayStatus.Obsolete:
                            <span class="badge bg-secondary">@Text.NotificationsObsoleteLabel</span>
                            break;
                        case NotificationDisplayStatus.Expired:
                            <span class="badge bg-secondary">@Text.NotificationsExpiredLabel</span>
                            break;
                        default:
                            <span class="badge bg-success">@Text.NotificationsActiveLabel</span>
                            break;
                    }
                </td>
                @if (ShowActionColumn)
                {
                    <td>
                        @if (CanExecuteAction(notification))
                        {
                            @if (ConfirmingActionForId == notification.Id)
                            {
                                @if (OffersResolutionChoice(notification))
                                {
                                    <button type="button" class="btn btn-sm btn-outline-secondary me-1"
                                            @onclick="() => ConfirmChoiceAsync(notification.Id, FieldResolutionChoice.Keep)">
                                        @Text.ImportReviewKeepExisting
                                    </button>
                                    <button type="button" class="btn btn-sm btn-danger me-1"
                                            @onclick="() => ConfirmChoiceAsync(notification.Id, FieldResolutionChoice.Replace)">
                                        @Text.ImportReviewTakeIncoming
                                    </button>
                                }
                                else
                                {
                                    <button type="button" class="btn btn-sm btn-danger" @onclick="() => ConfirmActionAsync(notification.Id)">@Text.NotificationsConfirmActionButton</button>
                                }
                                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="CancelAction">@Text.NotificationsCancelActionButton</button>
                                <div class="form-text">@Text.NotificationsConfirmActionWarning</div>
                            }
                            else
                            {
                                @* #308: named for what it does. A generic "Run" says nothing, and for an
                                   irreversible action that is exactly what the button has to say. *@
                                <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => ConfirmingActionForId = notification.Id">@ActionLabel(notification)</button>
                                @if (OffersResolutionChoice(notification))
                                {
                                    @* #303: the coarse options above settle a whole batch one way. The page is
                                       where a mixed backlog gets cleared action by action — and where #66's
                                       item-by-item UX will eventually live. *@
                                    <a class="btn btn-sm btn-link" href="import-review">@Text.ImportReviewOpenPageLink</a>
                                }
                            }
                        }
                    </td>
                }
                @if (ShowDismissAction)
                {
                    <td>
                        @if (ShowsDismissControl(notification, Executing.IsExecuting(notification.Id)))
                        {
                            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => OnDismiss.InvokeAsync(notification.Id)">@Text.NotificationsDismissButton</button>
                        }
                    </td>
                }
            </tr>
        }
    </tbody>
</table>

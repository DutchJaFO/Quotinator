@* No close button: this modal reports a startup failure, and its Continue button is the acknowledgement.
   A header X would let the operator dismiss the reason without reading the recovery route. *@
<ModalDialog ShowCloseButton="false" ContentClass="border-danger" HeaderClass="border-danger"
             TitleClass="text-danger" FooterClass="border-danger">
    <Title>
        @Text.StartupErrorHeading
        <span class="badge bg-secondary ms-2 fs-6 align-middle">v@(Version)</span>
    </Title>
    <ChildContent>
        <p class="text-muted">@FailureReason</p>

        <p>@Text.StartupErrorLastKnownGood</p>
        <NotificationSummary />
        <DatabaseStatsSummary />
    </ChildContent>
    <Footer>
        <button type="button" class="btn btn-outline-danger" @onclick="OnContinue">@Text.StartupErrorContinueButton</button>
    </Footer>
</ModalDialog>

@if (!StartupUx.SummaryDismissed)
{
    <div class="modal show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h1 class="modal-title fs-5">
                        @Text.StartupSummaryHeading
                        <span class="badge bg-secondary ms-2 fs-6 align-middle">v@(Version)</span>
                    </h1>
                    <button type="button" class="btn-close" aria-label="Close" @onclick="Dismiss"></button>
                </div>
                <div class="modal-body">
                    <p class="text-muted">@Text.StartupSummaryDescription</p>
                    <DatabaseStatsSummary />
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-primary" @onclick="Dismiss">@Text.StartupSummaryContinueButton</button>
                </div>
            </div>
        </div>
    </div>
}

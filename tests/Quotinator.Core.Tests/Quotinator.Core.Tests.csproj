<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Suppress CS1591: test methods don't require XML doc comments -->
    <!-- Suppress MSTEST0037: style-only analyzer added in MSTest 4.x, fixing assertions is out of scope here -->
    <NoWarn>$(NoWarn);1591;MSTEST0037</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.79" />
      <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.10" />
    <!-- CVE-2025-6965: native-binary-only override; Microsoft.Data.Sqlite still floors SQLitePCLRaw.core at 2.1.11, but this package carries no managed deps so it upgrades independently. See CVE/CVE-2025-6965.md. -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.50.3" />
      <PackageReference Include="JsonSchema.Net" Version="9.3.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.10" />
    <PackageReference Include="MSTest" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Quotinator.Constants\Quotinator.Constants.csproj" />
    <ProjectReference Include="..\..\src\Quotinator.Core\Quotinator.Core.csproj" />
    <ProjectReference Include="..\..\src\Quotinator.Data\Quotinator.Data.csproj" />
    <ProjectReference Include="..\..\src\Quotinator.Data.Testing\Quotinator.Data.Testing.csproj" />
  </ItemGroup>

</Project>

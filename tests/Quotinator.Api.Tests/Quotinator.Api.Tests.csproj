<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Suppress CS1591: test methods don't require XML doc comments -->
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MSTest" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="JsonSchema.Net" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Quotinator.Api\Quotinator.Api.csproj" />
    <ProjectReference Include="..\..\src\Quotinator.Converters.BasicJsonArray\Quotinator.Converters.BasicJsonArray.csproj" />
    <ProjectReference Include="..\..\src\Quotinator.Converters.RegexArray\Quotinator.Converters.RegexArray.csproj" />
    <ProjectReference Include="..\..\src\Quotinator.Data\Quotinator.Data.csproj" />
    <ProjectReference Include="..\..\src\Quotinator.Data.Testing\Quotinator.Data.Testing.csproj" />
  </ItemGroup>

  <!-- Make i18ntext source files available in the test output directory -->
  <ItemGroup>
    <Content Include="..\..\src\Quotinator.Api\i18ntext\*.json"
             Link="i18ntext\%(Filename)%(Extension)"
             CopyToOutputDirectory="Always" />
  </ItemGroup>

  <!-- Code samples the #313 guard is tested against. Plain text on purpose: compiled into this
       project they would be scanned by the very guard they exist to test. -->
  <ItemGroup>
    <Content Include="Startup\UnguardedFactoryFixtures\*.cs.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Records exactly what the compiler received, so the #313 source analysis compiles this project
       with the same sources, references, source generators and symbols rather than an approximation.
       An approximation that failed to bind would resolve nothing, and a guard resolving nothing passes. -->
  <Target Name="WriteCompilationInputsForFactoryGuard" AfterTargets="CoreCompile">
    <WriteLinesToFile File="$(OutDir)compilation-inputs\sources.txt" Lines="@(Compile->'%(FullPath)')" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <WriteLinesToFile File="$(OutDir)compilation-inputs\references.txt" Lines="@(ReferencePathWithRefAssemblies->'%(FullPath)')" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <WriteLinesToFile File="$(OutDir)compilation-inputs\analyzers.txt" Lines="@(Analyzer->'%(FullPath)')" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <WriteLinesToFile File="$(OutDir)compilation-inputs\defines.txt" Lines="$(DefineConstants)" Overwrite="true" WriteOnlyWhenDifferent="true" />
  </Target>

</Project>

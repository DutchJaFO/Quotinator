<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!-- Every package version used anywhere in the solution is declared exactly once, here.
       A <PackageReference> in a .csproj must never carry its own Version attribute (#320): with
       per-project pins, a dependency bump reaching some projects and not others resolves to two
       versions of one package and fails restore with NU1605.
       RepositoryStructureTests.PackageReferences_DoNotCarryInlineVersions enforces this. -->
  <ItemGroup>
    <PackageVersion Include="Dapper" Version="2.1.79" />
    <PackageVersion Include="Dapper.Contrib" Version="2.0.78" />
    <PackageVersion Include="JsonSchema.Net" Version="9.4.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.11" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.23.0" />
    <PackageVersion Include="MSTest" Version="4.3.3" />
    <PackageVersion Include="Scalar.AspNetCore" Version="2.17.1" />
    <PackageVersion Include="Serilog" Version="4.4.0" />
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageVersion Include="Serilog.Extensions.Logging" Version="10.0.0" />
    <PackageVersion Include="Toolbelt.Blazor.I18nText" Version="14.1.1" />
  </ItemGroup>

  <!-- Security-driven pins. Each is held at a specific version for a documented CVE reason rather
       than simply tracking latest — read the linked CVE doc before changing one. Summary of all
       known CVEs and their status: docs/security/README.md. -->
  <ItemGroup>
    <!-- CVE-2025-6965: native-binary-only override; Microsoft.Data.Sqlite still floors
         SQLitePCLRaw.core at 2.1.11, but this package carries no managed deps so it upgrades
         independently. See src/Quotinator.Data/CVE/archived/CVE-2025-6965.md. -->
    <PackageVersion Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3" />
    <!-- Direct override: Microsoft.AspNetCore.OpenApi 10.0.10 transitively pulls in the
         vulnerable Microsoft.OpenApi 2.0.0 (CVE-2026-49451, GHSA-v5pm-xwqc-g5wc). Forces
         resolution to the patched version until AspNetCore.OpenApi itself bumps its floor.
         2.11.0 is the latest 2.x release — the ceiling until AspNetCore.OpenApi's bundled
         XmlCommentGenerator supports Microsoft.OpenApi 3.x's read-only object model (see
         dotnet/aspnetcore#64317; src/Quotinator.Api/CVE/archived/CVE-2026-49451.md). -->
    <PackageVersion Include="Microsoft.OpenApi" Version="2.11.0" />
  </ItemGroup>

</Project>

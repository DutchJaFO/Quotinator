<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!-- Every package version used anywhere in the solution is declared exactly once, here.
       A <PackageReference> in a .csproj must never carry its own Version attribute (#320): with
       per-project pins, a dependency bump reaching some projects and not others resolves to two
       versions of one package and fails restore with NU1605.
       RepositoryStructureTests.PackageReferences_DoNotCarryInlineVersions enforces this. -->
  <ItemGroup>
    <PackageVersion Include="Dapper" Version="2.1.89" />
    <PackageVersion Include="Dapper.Contrib" Version="2.0.78" />
    <PackageVersion Include="JsonSchema.Net" Version="9.7.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.15" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.15" />
    <!-- Test-only: Quotinator.Api.Tests resolves its own sources to symbols to prove no test
         constructs the unguarded WebApplicationFactory<Program> (#313). Never referenced by src/. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.14" />
    <PackageVersion Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.23.0" />
    <PackageVersion Include="MSTest" Version="4.5.2" />
    <PackageVersion Include="Scalar.AspNetCore" Version="2.19.0" />
    <PackageVersion Include="Serilog" Version="4.4.0" />
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageVersion Include="Serilog.Extensions.Logging" Version="10.0.0" />
    <PackageVersion Include="Toolbelt.Blazor.I18nText" Version="14.1.1" />
  </ItemGroup>

  <!-- Security-driven pins belong in their own <ItemGroup> here, each with its CVE rationale as a
       comment (ADR 019). There are none at present: the last two, for CVE-2025-6965 and
       CVE-2026-49451, were removed once the packages that depend on them resolved patched versions
       by themselves. Summary of all known CVEs and their status: docs/security/README.md. -->

</Project>

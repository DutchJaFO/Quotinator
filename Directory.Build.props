<Project>

  <PropertyGroup>
    <Version>1.8.3</Version>
    <!-- AssemblyVersion and FileVersion require numeric-only; pin to base version when Version carries a prerelease suffix -->
    <AssemblyVersion>1.8.3.0</AssemblyVersion>
    <FileVersion>1.8.3.0</FileVersion>
    <Product>Quotinator</Product>
    <Authors>DutchJaFO</Authors>
    <Copyright>Copyright © 2026 DutchJaFO</Copyright>
  </PropertyGroup>

  <!-- #197: adopts MSTest.Analyzers' official "Recommended" severity preset (see
       mstest-recommended.globalconfig in the MSTest.Analyzers package) instead of hand-maintaining
       individual dotnet_diagnostic.MSTEST00NN.severity overrides in an .editorconfig — this stays in
       sync automatically as MSTest ships new analyzer rules, rather than silently missing them the
       way the previous unconfigured state (effectively "Default" mode) missed MSTEST0068/0046/0037
       being stuck at 'suggestion' severity, invisible to `dotnet build` regardless of verbosity. -->
  <PropertyGroup>
    <MSTestAnalysisMode>Recommended</MSTestAnalysisMode>
  </PropertyGroup>

  <!-- #244 Step 1: makes IDE0xxx code-style analyzers run at build time, not just in Visual Studio's
       live analysis. This alone does not surface them as build warnings — most IDE0xxx rules default
       to 'suggestion' severity, invisible to `dotnet build` regardless of verbosity, exactly like the
       MSTest rules above before #197. Severity escalation is a separate, later step (an .editorconfig
       entry), done incrementally per rule family rather than all at once. -->
  <PropertyGroup>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

</Project>
